# ===== بوت التسليم (إلزامي) =====
# من @BotFather ثم أرسل /start لبوتك وشغّل: python -m daryo.cli chatid
BOT_TOKEN=
OWNER_CHAT_ID=

# ===== قراءة القناة =====
# bot: البوت مشرف في القناة (الأفضل إن كانت القناة لك)
# auto: يستخدم حساب تيليجرام إن سُجّل، وإلا صفحة المعاينة العامة t.me/s/n9rfc
SOURCE_MODE=bot
SOURCE_CHANNEL=n9rfc
# من https://my.telegram.org > API development tools (حساب تيليجرام عضو في القناة، يُفضّل حساب ثانوي)
TG_API_ID=
TG_API_HASH=

# ===== التحرير بالذكاء الاصطناعي (موصى به) =====
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium

# ===== التشغيل =====
ACCOUNT_NAME=داريو النصر
SNAP_HANDLE=N9rfc1
TIMEZONE=Asia/Riyadh
# فارغ = طوال اليوم. مثال: 08:00-02:00
ACTIVE_HOURS=
POLL_MIN_SEC=120
POLL_MAX_SEC=180
CATCHUP_MAX_AGE_MIN=60
INITIAL_BACKFILL=0
ALBUM_MODE=first
USE_SOURCE_IMAGES=1
DEDUP_WINDOW_HOURS=72
ALERT_AFTER_FAILURES=3
